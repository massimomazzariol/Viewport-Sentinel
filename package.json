{
  "name": "viewport-sentinel",
  "version": "0.2.0",
  "packageManager": "pnpm@10.33.2",
  "description": "Responsive layout checks on real Chromium, Firefox and WebKit: horizontal overflow, edge leaks, clipped shadows and mobile menus you cannot use.",
  "bin": {
    "viewport-sentinel": "src/cli.js"
  },
  "scripts": {
    "scan": "node src/cli.js",
    "test": "node --test"
  },
  "keywords": [
    "playwright",
    "responsive",
    "qa",
    "layout",
    "testing",
    "visual",
    "overflow",
    "mobile"
  ],
  "author": "Massimo Mazzariol",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/massimomazzariol/Viewport-Sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/massimomazzariol/Viewport-Sentinel/issues"
  },
  "homepage": "https://github.com/massimomazzariol/Viewport-Sentinel#readme",
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "playwright": "^1.44.0",
    "pngjs": "^7.0.0"
  }
}
